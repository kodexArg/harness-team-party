{
  "mcpServers": {
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@1.6.0",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "env": {}
    },
    "laya": {
      "command": "/home/kodex/.local/bin/kdx-mcp-runner",
      "args": [
        "/home/kodex/Services/laya-mcp/.venv/bin/laya-mcp",
        "stdio"
      ],
      "env": {
        "PATH": "/home/kodex/Services/laya-mcp/.venv/bin:/home/kodex/.local/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--from",
        "graphifyy[mcp]",
        "python3",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    }
  }
}
